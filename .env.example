OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_MS=60000

OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=20000

PORT=3000
# 127.0.0.1 keeps the server private to this computer.
# Use HOST=0.0.0.0 only when other devices on your network must reach it.
HOST=127.0.0.1

# Per-client limit for POST /api/* requests per minute (0 disables it).
API_RATE_LIMIT_PER_MINUTE=60
# Maximum number of in-memory chat sessions (least recently used are evicted).
MAX_SESSIONS=1000

# When true, logs raw chat messages, place names and coordinates.
# Keep false on any shared or public deployment.
DEBUG_MODE=false

VBN_OTP_API_KEY=replace-me
VBN_OTP_API_BASE=https://gtfsr.vbn.de/api
VBN_OTP_ROUTER_ID=connect
VBN_OTP_AUTH_SCHEME=
# The server caps this value at 5000 ms.
VBN_OTP_TIMEOUT_MS=5000

GEOCODER_BASE_URL=https://nominatim.openstreetmap.org/search
# The server caps this value at 2500 ms.
GEOCODER_TIMEOUT_MS=2500
# Nominatim policy: identify your application. Adding a contact URL or email
# you control is recommended, e.g. "oldenburg-transport-chatbot/1.0 (https://example.org/contact)".
GEOCODER_USER_AGENT=oldenburg-transport-chatbot/1.0
# Minimum gap between geocoder requests. The public Nominatim server is always
# limited to at least 1000 ms; lower values only apply to self-hosted geocoders.
GEOCODER_MIN_INTERVAL_MS=1100
